{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/ste-always-on.sh\"",
            "timeout": 5,
            "statusMessage": "Checking ASD-STE100 always-on flag..."
          }
        ]
      }
    ]
  }
}
